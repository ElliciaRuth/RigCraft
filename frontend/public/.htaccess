# Copied into dist/ by `npm run build`. Serves the built app as plain files.
# "RewriteEngine On" with no rules stops the parent folders' rules re-applying.
Options -Indexes
RewriteEngine On

# Hashed build files never change: cache them for a year. index.html: always revalidate.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2?|ttf|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <Files "index.html">
    Header set Cache-Control "no-cache"
  </Files>
</IfModule>
