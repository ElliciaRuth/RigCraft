#--------------------------------------------------------------------
# RigCraft — CodeIgniter environment (template)
# Copy this file to .env and adjust. .env is not committed to git.
#--------------------------------------------------------------------

CI_ENVIRONMENT = production

#--------------------------------------------------------------------
# App
#--------------------------------------------------------------------
# The API is reached through /RigCraft/api/* (see ../.htaccess).
app.baseURL = 'http://127.0.0.1/RigCraft/'
app.indexPage = ''
# Order numbers and default sale dates use Philippine time.
app.appTimezone = 'Asia/Manila'

#--------------------------------------------------------------------
# Database (XAMPP defaults: user "root", empty password)
#--------------------------------------------------------------------
database.default.hostname = 127.0.0.1
database.default.database = rigcraft_db
database.default.username = root
database.default.password =
database.default.DBDriver = MySQLi
database.default.DBPrefix =
database.default.port = 3306
database.default.charset = utf8mb4
database.default.DBCollat = utf8mb4_unicode_ci

#--------------------------------------------------------------------
# Session — own cookie name so it won't clash with other htdocs apps.
# expiration = 0 → the cookie lasts until the browser is closed.
#--------------------------------------------------------------------
session.cookieName = 'RIGCRAFTSESS'
session.expiration = 0
